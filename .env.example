# Environment Configuration Example
# Copy this file to .env and fill in the values

# Application
NODE_ENV=development
PORT=3000
APP_NAME=PathWise
APP_VERSION=1.0.0

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pathwise
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=pathwise
DATABASE_USER=pathwise_user
DATABASE_PASSWORD=your_secure_password

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication
AUTH_SECRET=your_auth_secret_key_here_minimum_32_characters
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters
JWT_EXPIRES_IN=24h
OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret
OAUTH_MICROSOFT_CLIENT_ID=your_microsoft_client_id
OAUTH_MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

# AI Services
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
AI_MODEL_PRIMARY=gpt-4o
AI_MODEL_FALLBACK=claude-3-5-sonnet

# Vector Database
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=pathwise-embeddings

# ElasticSearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elasticsearch_password

# AWS / Cloud Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=pathwise-documents
S3_BUCKET_REGION=us-east-1

# Email & Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# API Gateway
API_GATEWAY_PORT=4000
GRAPHQL_PLAYGROUND=true

# Service Ports
AUTH_SERVICE_PORT=4001
IEP_SERVICE_PORT=4002
ADAPTIVE_SERVICE_PORT=4003
AI_ENGINE_PORT=4004
NOTIFICATION_SERVICE_PORT=4005

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_AI_GENERATION=true
ENABLE_OFFLINE_MODE=true
ENABLE_VOICE_NAVIGATION=true
ENABLE_PARENT_PORTAL=true

# Compliance
FERPA_MODE=strict
AUDIT_LOG_RETENTION_DAYS=2555
DATA_ENCRYPTION_ENABLED=true

# Development
DEBUG=true
LOG_LEVEL=debug
ENABLE_SWAGGER_DOCS=true
