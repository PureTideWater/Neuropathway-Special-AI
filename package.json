{
  "name": "pathwise",
  "version": "1.0.0",
  "description": "PathWise - IEP Copilot and AI Adaptive Learning Partner",
  "private": true,
  "workspaces": [
    "frontend",
    "services/*",
    "shared/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:services\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:services": "concurrently \"npm run dev:auth\" \"npm run dev:iep\" \"npm run dev:ai-engine\" \"npm run dev:adaptive\" \"npm run dev:gateway\"",
    "dev:auth": "cd services/auth-service && npm run dev",
    "dev:iep": "cd services/iep-service && npm run dev",
    "dev:ai-engine": "cd services/ai-engine && npm run dev",
    "dev:adaptive": "cd services/adaptive-learning-service && npm run dev",
    "dev:gateway": "cd services/api-gateway && npm run dev",
    "build": "npm run build:frontend && npm run build:services",
    "build:frontend": "cd frontend && npm run build",
    "build:services": "cd services && npm run build:all",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --config jest.config.js tests/unit",
    "test:integration": "jest --config jest.config.js tests/integration",
    "test:e2e": "playwright test",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "cd database && npm run migrate",
    "db:seed": "cd database && npm run seed"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
